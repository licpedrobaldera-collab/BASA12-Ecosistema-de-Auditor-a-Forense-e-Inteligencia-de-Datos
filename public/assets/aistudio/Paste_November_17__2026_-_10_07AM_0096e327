            st.rerun()

    tab1, tab2, tab3 = st.tabs([
        "📤 1. Cargar y Extraer Informe Real",
        "📝 2. Matriz Íntegra Editable y Exportación",
        "📚 3. Histórico de Entidades e Informes"
    ])

    # TAB 1: CARGA
    with tab1:
        st.subheader("Cargar Informe de Auditoría (Se actualiza 100% con el contenido real cargado)")
        uploaded = st.file_uploader("Seleccione archivo (DOCX, PDF, XLSX, CSV, TXT, MD):", type=["docx", "pdf", "xlsx", "xls", "csv", "txt", "md"])
        if uploaded:
            file_bytes = uploaded.getvalue()
            sha256_hash = compute_sha256(file_bytes)
            st.info(f"**Archivo:** `{uploaded.name}` | **SHA-256:** `{sha256_hash}`")
            if st.button("🚀 Extraer Todos los Hallazgos Íntegramente y Guardar en BD", type="primary"):
                with st.spinner("Leyendo estructura XML/Esquema y reconstruyendo cada hallazgo textual..."):
                    records, meta_doc = extract_structured_lines(uploaded.name, file_bytes)
                    findings = segment_findings_from_records(records)
                if not findings:
                    st.error("No se detectaron códigos de hallazgo válidos (ej. 3.01, 3.1.01, 3.4.1) en el documento.")
                else:
                    df_res = analyze_findings_pipeline(
                        findings,
                        use_ollama=("Ollama" in modo_motor),
                        ollama_url=ollama_url,
                        ollama_model=ollama_model
                    )
                    audit_id = db_save_audit(uploaded.name, sha256_hash, modo_motor, meta_doc, df_res)
                    st.session_state["active_audit_id"] = audit_id
                    st.success(f"✅ Se extrajeron **{len(findings)} hallazgos íntegros** ({meta_doc}) y se guardaron en BD con ID #{audit_id}. Pase a la Pestaña 2.")

    # TAB 2: EDITOR CRUD + EXPORTACIÓN DIRECTA
    with tab2:
        audits_df = db_list_audits()
        if audits_df.empty:
            st.warning("No hay auditorías registradas. Cargue un documento en la Pestaña 1.")
        else:
            options = {f"#{r['ID']} | {r['Archivo']} ({r['Hallazgos']} hallazgos - Prom: {r['Promedio']}/10)": r for _, r in audits_df.iterrows()}
            default_idx = 0
            if "active_audit_id" in st.session_state:
                for i, (_, r) in enumerate(options.items()):
                    if int(r["ID"]) == st.session_state["active_audit_id"]:
                        default_idx = i
                        break

            sel_label = st.selectbox("Seleccione Entidad / Informe Activo:", list(options.keys()), index=default_idx)
            sel_row = options[sel_label]
            aid = int(sel_row["ID"])
            st.session_state["active_audit_id"] = aid

            df_h = db_load_hallazgos(aid)

            meta_dict = {"archivo": sel_row["Archivo"], "sha256": sel_row["SHA256_Full"]}
            b1, b2, b3 = st.columns(3)
            with b1:
                st.download_button(
                    "📊 Exportar Matriz Íntegra a Excel (.xlsx)",
                    data=export_to_excel_bytes(df_h, meta_dict),
                    file_name=f"BASA13_Matriz_Integra_ID{aid}.xlsx",
                    mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                    use_container_width=True
                )
            with b2:
                st.download_button(
                    "📄 Exportar Informe a Word (.docx)",
                    data=export_to_word_bytes(df_h, meta_dict),
                    file_name=f"BASA13_Informe_Integro_ID{aid}.docx",
                    mime="application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                    use_container_width=True
                )
            with b3:
                st.download_button(
                    "📑 Exportar Datos a CSV (.csv)",
                    data=df_h.drop(columns=["ID_BD"], errors="ignore").to_csv(index=False).encode("utf-8-sig"),
                    file_name=f"BASA13_Hallazgos_ID{aid}.csv",
                    mime="text/csv",
                    use_container_width=True
                )

            st.divider()
            c1, c2, c3, c4 = st.columns(4)
            c1.metric("Total Hallazgos Extraídos", len(df_h))
            c2.metric("Verificados", int(df_h["Verificado"].sum()) if not df_h.empty else 0)
            c3.metric("Promedio Puntaje", f"{df_h['Puntaje 0–10'].mean():.2f}/10" if not df_h.empty else "0.0")
            c4.metric("Conservar", int((df_h["Clasificación"] == "CONSERVAR").sum()) if not df_h.empty else 0)

            edited_df = st.data_editor(
                df_h,
                num_rows="dynamic",
                use_container_width=True,
                height=440,
                column_config={
                    "ID_BD": st.column_config.NumberColumn("ID", disabled=True),
                    "Verificado": st.column_config.CheckboxColumn("Verificado", default=False),
                    "Puntaje 0–10": st.column_config.NumberColumn("Puntaje", min_value=0.0, max_value=10.0, step=0.5),
                    "Clasificación": st.column_config.SelectboxColumn("Clasificación", options=["CONSERVAR", "MEJORAR", "CONSOLIDAR", "ELIMINAR"])
                }
            )

            col_s1, col_s2, col_s3 = st.columns(3)
            with col_s1:
                if st.button("💾 Guardar Cambios en BD", type="primary", use_container_width=True):
                    db_update_hallazgos_bulk(aid, edited_df, "EN REVISIÓN")
                    st.success("✅ Cambios guardados en SQLite.")
                    st.rerun()
            with col_s2:
                if st.button("✅ Verificar Todos y Guardar", use_container_width=True):
                    edited_df["Verificado"] = True
                    db_update_hallazgos_bulk(aid, edited_df, "VERIFICADA")
                    st.success("✅ Auditoría marcada como 100% verificada.")
                    st.rerun()
            with col_s3:
                if st.button("🗑️ Eliminar Auditoría", use_container_width=True):
                    db_delete_audit(aid)
                    st.session_state.pop("active_audit_id", None)
                    st.warning("Auditoría eliminada.")
                    st.rerun()

    # TAB 3: HISTÓRICO GENERAL
    with tab3:
        st.subheader("📚 Histórico de Entidades e Informes Evaluados")
        hist = db_list_audits()
        if hist.empty:
            st.info("Sin registros históricos aún.")
        else:
            st.dataframe(hist.drop(columns=["SHA256_Full"]), use_container_width=True)


if __name__ == "__main__":
    main()