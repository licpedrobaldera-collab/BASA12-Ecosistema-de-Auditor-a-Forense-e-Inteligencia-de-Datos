# ==============================================================================
# FASE 1: LECTOR AVANZADO DE DOCX (RECONSTRUYE NUMERACIÓN AUTOMÁTICA XML)
# ==============================================================================
def compute_sha256(file_bytes: bytes) -> str:
    return hashlib.sha256(file_bytes).hexdigest()


def iter_docx_blocks(doc: docx.Document):
    parent_elm = doc.element.body
    for child in parent_elm.iterchildren():
        if child.tag.endswith("p"):
            yield docx.text.paragraph.Paragraph(child, doc)
        elif child.tag.endswith("tbl"):
            yield docx.table.Table(child, doc)


def get_paragraph_auto_number_info(paragraph: docx.text.paragraph.Paragraph) -> Tuple[bool, int, str]:
    """
    Detecta si el párrafo pertenece a un encabezado multinivel o numeración automática XML
    en Word (ej. Heading 1/2/3, Título 1/2/3 o w:numPr) para no perder códigos automáticos.
    """
    style_name = (paragraph.style.name or "").strip().lower()
    pPr = paragraph._p.pPr
    ilvl = None
    numId = None

    if pPr is not None and pPr.numPr is not None:
        if pPr.numPr.ilvl is not None:
            ilvl = int(pPr.numPr.ilvl.val)
        if pPr.numPr.numId is not None:
            numId = str(pPr.numPr.numId.val)

    is_heading = (
        style_name.startswith("heading")
        or style_name.startswith("título")
        or style_name.startswith("titulo")
        or (ilvl is not None and numId is not None and numId != "0")
    )
    return is_heading, (ilvl if ilvl is not None else -1), style_name


def extract_structured_lines(file_name: str, file_bytes: bytes) -> Tuple[List[Dict[str, str]], str]:
    ext = os.path.splitext(file_name)[1].lower()
    records: List[Dict[str, str]] = []
    meta_info = ""

    if ext == ".docx":
        doc = docx.Document(io.BytesIO(file_bytes))
        idx = 0
        tbl_count = 0

        # Rastreadores de numeración automática de Word por niveles (0=Cap, 1=Sec, 2=Hallazgo)
        counters = [0, 0, 0, 0]
        in_cap3_auto = False

        for block in iter_docx_blocks(doc):
            if isinstance(block, docx.text.paragraph.Paragraph):
                txt = block.text.strip()
                if not txt:
                    continue
                idx += 1

                is_head, ilvl, style_name = get_paragraph_auto_number_info(block)

                # Si el texto ya trae su código explícito (ej. "3.1.01 Debilidades..." o "3.4.1 Ausencia...")
                explicit_code_match = re.match(r"^(3(?:\.\d+){1,2})\b", txt)
                if explicit_code_match:
                    parts = explicit_code_match.group(1).split(".")
                    counters[0] = int(parts[0])
                    if len(parts) >= 2:
                        counters[1] = int(parts[1])
                    if len(parts) >= 3:
                        counters[2] = int(parts[2])
                    else:
                        counters[2] = 0
                    in_cap3_auto = True
                elif is_head:
                    # Detectar inicio de Capítulo 3 aunque el "3." sea automático
                    if re.match(r"^(?:HALLAZGOS|RESULTADOS\s+DE\s+LA\s+AUDITOR[ÍI]A|OBSERVACIONES)", txt, re.IGNORECASE) and ilvl in [0, -1]:
                        counters = [3, 0, 0, 0]
                        in_cap3_auto = True
                        txt = f"3. {txt}"
                    elif in_cap3_auto:
                        if ilvl == 0 or "heading 1" in style_name or "título 1" in style_name:
                            # Pasó al capítulo 4
                            counters[0] += 1
                            in_cap3_auto = False
                            txt = f"{counters[0]}. {txt}"
                        elif ilvl == 1 or "heading 2" in style_name or "título 2" in style_name:
                            counters[1] += 1
                            counters[2] = 0
                            txt = f"3.{counters[1]} {txt}"
                        elif ilvl == 2 or "heading 3" in style_name or "título 3" in style_name:
                            counters[2] += 1
                            txt = f"3.{counters[1]}.{counters[2]:02d} {txt}"

                records.append({
                    "loc": f"Párrafo {idx}",
                    "type": "text",
                    "content": txt,
                    "is_heading": str(is_head)
                })

            elif isinstance(block, docx.table.Table):
                tbl_count += 1
                rows_txt = []
                for row in block.rows:
                    cells = [c.text.strip().replace("\n", " ") for c in row.cells]
                    rows_txt.append(" | ".join(cells))
                tbl_str = "\n".join(rows_txt).strip()
                if tbl_str:
                    idx += 1
                    records.append({
                        "loc": f"Párrafo/Tabla {idx} (Tabla #{tbl_count})",
                        "type": "table",
                        "content": f"[TABLA ADJUNTA]\n{tbl_str}",
                        "is_heading": "False"
                    })
        meta_info = f"DOCX: {idx} bloques extraídos ({tbl_count} tablas)"

    elif ext == ".pdf":
        reader = PdfReader(io.BytesIO(file_bytes))
        total_pages = len(reader.pages)
        line_num = 0
        for p_idx, page in enumerate(reader.pages, start=1):
            page_txt = page.extract_text() or ""
            for raw_line in page_txt.splitlines():
                clean = raw_line.strip()
                if clean:
                    line_num += 1
                    records.append({"loc": f"Pág. {p_idx} / Línea {line_num}", "type": "text", "content": clean, "is_heading": "False"})
        meta_info = f"PDF: {total_pages} páginas / {line_num} líneas"

    elif ext in [".xlsx", ".xls"]:
        xls = pd.ExcelFile(io.BytesIO(file_bytes))
        row_counter = 0
        for sheet in xls.sheet_names:
            df_s = xls.parse(sheet).fillna("")
            for r_idx, row in df_s.iterrows():
                row_counter += 1
                joined = " | ".join([f"{col}: {val}" for col, val in row.items() if str(val).strip()])
                if joined:
                    records.append({"loc": f"Hoja '{sheet}' Fila {r_idx + 2}", "type": "table", "content": joined, "is_heading": "False"})
        meta_info = f"Excel: {len(xls.sheet_names)} hojas / {row_counter} filas"

    else:
        text = file_bytes.decode("utf-8", errors="replace")
        for i, line in enumerate(text.splitlines(), start=1):
            if line.strip():
                records.append({"loc": f"Línea {i}", "type": "text", "content": line.strip(), "is_heading": "False"})
        meta_info = f"Texto/CSV/MD: {len(records)} líneas"

    return records, meta_info


# ==============================================================================
# FASE 2 Y 3: DETECCIÓN Y TRANSCRIPCIÓN ÍNTEGRA DE TODOS LOS HALLAZGOS
# ==============================================================================
# Secciones generales: 3.1, 3.2, 3.3, 3.4 (NO son hallazgos)
RE_SECTION_HEADER = re.compile(r"^(3\.[1-9])\s+([A-ZÁÉÍÓÚÑa-záéíóúñ].{3,200})$")

# Hallazgos específicos:
# Soporta 3.01..3.99, 3.1.01..3.9.99, 3.4.1..3.9.9 (con o sin espacio tras el código, ej. "3.2.03Expedientes...")
RE_FINDING_HEADER = re.compile(
    r"^(3\.(?:0[1-9]|[1-9]\d|[1-9]\.(?:0[1-9]|[1-9]\d?)))\s*[-–:.]?\s*([A-ZÁÉÍÓÚÑa-záéíóúñ\"“«(].+)$"
)

# Fin del capítulo 3 (ej. 4. CONCLUSIONES, IV., ANEXOS)
RE_CHAPTER_END = re.compile(
    r"^(?:4\.|IV\.|CONCLUSIONES\s+GENERALES|RECOMENDACIONES\s+GENERALES|ANEXOS\b)",
    re.IGNORECASE
)


def is_valid_finding_code(code: str) -> bool:
    parts = code.split(".")
    if parts[0] != "3":
        return False
    if len(parts) == 2:
        # 3.01, 3.02, 3.10 -> válido; 3.1, 3.2 -> sección general
        return len(parts[1]) >= 2 and int(parts[1]) >= 1
    if len(parts) == 3:
        # 3.1.01, 3.2.03, 3.4.1 -> todos válidos
        return int(parts[1]) >= 1 and int(parts[2]) >= 1
    return False


def segment_findings_from_records(records: List[Dict[str, str]]) -> List[Dict[str, Any]]:
    findings: List[Dict[str, Any]] = []
    current_section = "3. Hallazgos de Auditoría / Investigación Especial"
    active_finding: Dict[str, Any] = None
    in_chapter_3 = False

    for rec in records:
        txt = rec["content"].strip()
        loc = rec["loc"]

        # Ignorar entradas del índice / tabla de contenido (terminan en puntos suspensivos y número de página)
        if re.search(r"(?:\.{3,}|\t+)\s*\d{1,3}$", txt):
            continue

        # Fin del capítulo 3
        if in_chapter_3 and RE_CHAPTER_END.match(txt) and len(txt) < 120:
            if active_finding:
                findings.append(active_finding)
                active_finding = None
            break

        # Detectar sección general (3.1, 3.2, 3.3, 3.4...)
        sec_match = RE_SECTION_HEADER.match(txt)
        if sec_match and not is_valid_finding_code(sec_match.group(1)):
            if active_finding:
                findings.append(active_finding)
                active_finding = None
            current_section = f"{sec_match.group(1)} {sec_match.group(2).strip()}"
            in_chapter_3 = True
            continue

        # Detectar inicio de hallazgo específico (3.1.01, 3.2.03, 3.4.1, 3.01...)
        f_match = RE_FINDING_HEADER.match(txt)
        if f_match and is_valid_finding_code(f_match.group(1)):
            code = f_match.group(1).strip()
            title = f_match.group(2).strip()

            # Evitar falsos positivos de citas internas tipo "3.1.01 del informe anterior."
            if len(title) < 8 or title.endswith(".") and len(title.split()) > 25:
                if active_finding is not None:
                    active_finding["blocks"].append(txt)
                    active_finding["end_loc"] = loc
                continue

            if active_finding:
                findings.append(active_finding)

            in_chapter_3 = True
            active_finding = {
                "seccion": current_section,
                "codigo": code,
                "titulo": title,
                "start_loc": loc,
                "end_loc": loc,
                "blocks": [txt]
            }
            continue

        # Acumular TODO el texto y tablas dentro del hallazgo activo (transcripción textual íntegra)
        if active_finding is not None:
            active_finding["blocks"].append(txt)
            active_finding["end_loc"] = loc

    if active_finding:
        findings.append(active_finding)

    # Si un código apareció primero en un índice sin puntos suspensivos (bloque corto) y luego en el cuerpo (bloque largo), conservar el desarrollo completo
    by_code: Dict[str, Dict[str, Any]] = {}
    order_codes: List[str] = []
    for item in findings:
        full_text = "\n\n".join(item["blocks"])
        item["transcripcion_integra"] = full_text
        item["ubicacion"] = f"{item['start_loc']} → {item['end_loc']}"
        c = item["codigo"]
        if c not in by_code:
            by_code[c] = item
            order_codes.append(c)
        else:
            if len(full_text) > len(by_code[c]["transcripcion_integra"]):
                by_code[c] = item

    return [by_code[c] for c in order_codes]


