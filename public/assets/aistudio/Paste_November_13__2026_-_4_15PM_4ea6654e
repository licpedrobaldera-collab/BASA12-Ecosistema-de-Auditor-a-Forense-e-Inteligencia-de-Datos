        st.markdown("### Resumen del Blindaje Institucional")
        total = len(st.session_state.hallazgos_extraidos)
        promedio = sum([h.get('Calificación (0-10)', 0) for h in st.session_state.hallazgos_extraidos]) / total if total > 0 else 0
        
        col_m1, col_m2, col_m3 = st.columns(3)
        with col_m1: st.metric("Total Hallazgos Evaluados", total)
        with col_m2: st.metric("Promedio Puntaje (0-10)", f"{round(promedio, 1)} / 10")
        with col_m3: st.metric("Dictamen Final", "Apto para Autoridades")

    # ==========================================================================
    # PASO 4: EXPORTACIÓN DE INFORMES OFICIALES
    # ==========================================================================
    elif st.session_state.paso_actual == 4:
        st.markdown("## 📥 Paso 4: Exportación de Matriz Consolidada y Reportes Aprobados")
        st.info("Descargue los documentos oficiales en formatos Excel y Word con toda la validación normativa, gráficos de riesgo y recomendaciones 100/100.")

        col_ex1, col_ex2 = st.columns(2)
        with col_ex1:
            excel_bytes = generar_excel_matriz_completa(st.session_state.hallazgos_extraidos)
            st.download_button(
                label="📊 Descargar Matriz Consolidada en Excel (.xlsx)",
                data=excel_bytes,
                file_name=f"Matriz_Consolidada_CCRD_{datetime.now().strftime('%Y%m%d_%H%M')}.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            )
        with col_ex2:
            word_bytes = generar_word_informe_completo(st.session_state.entidad_auditada or "Entidad Auditada", st.session_state.hallazgos_extraidos)
            st.download_button(
                label="📝 Descargar Informe Consolidado en Word (.docx)",
                data=word_bytes,
                file_name=f"Informe_Consolidado_CCRD_{datetime.now().strftime('%Y%m%d_%H%M')}.docx",
                mime="application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            )


