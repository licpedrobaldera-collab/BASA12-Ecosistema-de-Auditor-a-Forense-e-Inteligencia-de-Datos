def generar_excel_matriz_completa(hallazgos: List[Dict[str, Any]]) -> bytes:
    df = pd.DataFrame(hallazgos)
    output = io.BytesIO()
    with pd.ExcelWriter(output, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Matriz Consolidada 100-100")
    return output.getvalue()


def generar_word_informe_completo(entidad: str, hallazgos: List[Dict[str, Any]]) -> bytes:
    doc = Document()
    doc.add_heading(f"INFORME TÉCNICO CONSOLIDADO DE AUDITORÍA FORENSE\nEntidad: {entidad}", 0)
    
    doc.add_heading("1. Resumen de Validación, Criterios y Riesgos (Ley núm. 18-24)", level=1)
    doc.add_paragraph("Este informe presenta la evaluación completa bajo los estándares de la Cámara de Cuentas, separando los componentes correctos de aquellos que requieren ajuste para alcanzar el 100/100.")
    
    correctos = [h for h in hallazgos if "Correcto" in h.get("Estado", "")]
    ajustes = [h for h in hallazgos if "Ajuste" in h.get("Estado", "") or "Observación" in h.get("Estado", "")]

    doc.add_heading(f"2. Componentes Correctos ({len(correctos)})", level=1)
    for h in correctos:
        doc.add_heading(f"[{h.get('ID')}] {h.get('Sección / Acápite')}", level=2)
        doc.add_paragraph(f"Calificación: {h.get('Calificación (0-10)')}/10 | Estado: {h.get('Estado')}")
        doc.add_paragraph(f"Criterio Validado: {h.get('Criterio Sugerido IA')} ({h.get('Referencia Exacta')})")
        doc.add_paragraph("-" * 40)

    doc.add_heading(f"3. Componentes con Observación y Sugerencia de Ajuste ({len(ajustes)})", level=1)
    for h in ajustes:
        doc.add_heading(f"[{h.get('ID')}] {h.get('Sección / Acápite')}", level=2)
        doc.add_paragraph(f"Calificación: {h.get('Calificación (0-10)')}/10 | Riesgo: {h.get('Nivel de Riesgo')}")
        doc.add_paragraph(f"Criterio Original: {h.get('Criterio Auditor')}")
        doc.add_paragraph(f"Criterio Sugerido por IA: {h.get('Criterio Sugerido IA')} [{h.get('Referencia Exacta')}]")
        doc.add_paragraph(f"Recomendación de Mejora (10/10): {h.get('Recomendación de Mejora (10/10)')}")
        doc.add_paragraph("-" * 40)

    output = io.BytesIO()
    doc.save(output)
    return output.getvalue()


