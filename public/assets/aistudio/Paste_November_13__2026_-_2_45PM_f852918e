# FUNCIONES DE EXPORTACIÓN A EXCEL Y WORD (REPORTES DE MEJORA Y MATRICES)
# ==============================================================================
def generar_excel_matriz(hallazgos: List[Dict[str, Any]]) -> bytes:
    df = pd.DataFrame(hallazgos)
    output = io.BytesIO()
    with pd.ExcelWriter(output, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Matriz de Hallazgos y Supervisor")
    return output.getvalue()


def generar_word_reporte_mejoras(resumen: Dict[str, Any], hallazgos: List[Dict[str, Any]]) -> bytes:
    doc = Document()
    doc.add_heading("REPORTE EJECUTIVO DE COMUNICACIÓN DE MEJORAS Y DESCARGOS", 0)
    doc.add_paragraph(f"Entidad Auditada: {resumen.get('entidad_auditada')}")
    doc.add_paragraph(f"Tipo de Auditoría: {resumen.get('tipo_auditoria')}")
    doc.add_paragraph(f"Puntaje de Blindaje Global: {resumen.get('porcentaje_blindaje_global')}%")
    doc.add_paragraph(f"Dictamen del Supervisor IA: {resumen.get('conclusion_supervisor')}")
    
    doc.add_heading("Análisis y Propuestas de Redacción por Componente (10/10)", level=1)
    for h in hallazgos:
        doc.add_heading(f"[{h.get('id_hallazgo')}] {h.get('titulo')}", level=2)
        doc.add_paragraph(f"Calificación Asignada: {h.get('puntaje_0_10')}/10 | Estado: {h.get('estado_procesal')}")
        doc.add_paragraph(f"Responsable: {h.get('director_responsable')}")
        
        doc.add_heading("Lo que dice el informe actual:", level=3)
        doc.add_paragraph(h.get('lo_que_dice_exactamente'))
        
        doc.add_heading("Análisis Crítico del Supervisor (IA):", level=3)
        doc.add_paragraph(h.get('analisis_del_supervisor'))
        
        doc.add_heading("Redacción Propuesta Optimizada (Para Blindaje 10/10):", level=3)
        doc.add_paragraph(h.get('redaccion_propuesta_ia'))
        
        doc.add_paragraph("-" * 50)
        
    output = io.BytesIO()
    doc.save(output)
    return output.getvalue()


