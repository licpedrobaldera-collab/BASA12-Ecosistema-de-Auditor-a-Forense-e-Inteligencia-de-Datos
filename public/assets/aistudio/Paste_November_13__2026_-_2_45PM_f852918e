# FUNCIONES DE EXTRACCIÓN REAL MULTIFORMATO Y CADENA DE CUSTODIA (SHA-256)
# ==============================================================================
def calcular_sha256(contenido_bytes: bytes) -> str:
    return hashlib.sha256(contenido_bytes).hexdigest()


def extraer_texto_archivo(uploaded_file) -> Dict[str, Any]:
    raw_bytes = uploaded_file.getvalue()
    sha256_hash = calcular_sha256(raw_bytes)
    nombre = uploaded_file.name
    ext = nombre.split(".")[-1].lower() if "." in nombre else ""
    texto = ""

    try:
        if ext == "pdf":
            reader = PdfReader(io.BytesIO(raw_bytes))
            paginas = []
            for idx, page in enumerate(reader.pages, start=1):
                txt_pag = page.extract_text() or ""
                if txt_pag.strip():
                    paginas.append(f"--- PÁGINA {idx} ---\n{txt_pag}")
            texto = "\n\n".join(paginas)

        elif ext == "docx":
            doc = Document(io.BytesIO(raw_bytes))
            partes = [p.text for p in doc.paragraphs if p.text.strip()]
            for t_idx, tabla in enumerate(doc.tables, start=1):
                filas_txt = []
                for row in tabla.rows:
                    celdas = [c.text.strip().replace("\n", " ") for c in row.cells]
                    filas_txt.append(" | ".join(celdas))
                if filas_txt:
                    partes.append(f"\n[TABLA {t_idx}]\n" + "\n".join(filas_txt))
            texto = "\n".join(partes)

        elif ext in ["xlsx", "xls"]:
            xls = pd.ExcelFile(io.BytesIO(raw_bytes))
            hojas = []
            for sheet in xls.sheet_names:
                df_sheet = pd.read_excel(xls, sheet_name=sheet)
                hojas.append(f"=== HOJA: {sheet} ===\n{df_sheet.to_csv(index=False)}")
            texto = "\n\n".join(hojas)

        elif ext == "csv":
            df_csv = pd.read_csv(io.BytesIO(raw_bytes))
            texto = df_csv.to_csv(index=False)

        else:
            texto = raw_bytes.decode("utf-8", errors="replace")

    except Exception as e:
        texto = f"[Error al extraer texto de {nombre}: {str(e)}]"

    return {
        "nombre": nombre,
        "extension": ext.upper(),
        "tamano_kb": round(len(raw_bytes) / 1024, 2),
        "sha256": sha256_hash,
        "texto": texto.strip(),
    }


