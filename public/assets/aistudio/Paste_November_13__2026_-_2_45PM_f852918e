        if st.button("🚀 Ejecutar Verificación de Informe conforme a la Guía", type="primary"):
            with st.spinner("Validando cumplimiento normativo y cadena de custodia SHA-256..."):
                docs_procesados = [extraer_texto_archivo(f) for f in uploaded_files] if uploaded_files else []
                processor_guia = CCRDFiscalGuideProcessor()
                st.session_state.resultado_verificacion_guia = processor_guia.verificar_cumplimiento_guia(docs_procesados)
                st.success("¡Verificación completada!")

        if st.session_state.resultado_verificacion_guia:
            res_guia = st.session_state.resultado_verificacion_guia
            st.markdown("### 📊 Reporte de Conformidad Normativa")
            st.write(f"**Institución:** {res_guia['institucion']}")
            st.write(f"**Marco Regulatorio:** {res_guia['marco_normativo']}")
            st.success(f"**Dictamen General:** {res_guia['dictamen_conformidad']}")

            st.markdown("#### 🔐 Cadena de Custodia (SHA-256)")
            for h_val in res_guia["hashes_sha256"]:
                st.code(h_val, language="text")

            st.markdown("#### 🔄 Estado de las Etapas de la Guía de Fiscalización")
            for etapa in res_guia["etapas_analizadas"]:
                with st.expander(f"Paso {etapa['step']}: {etapa['title']} — Estado: [{etapa['status']}]"):
                    st.write(f"**Descripción:** {etapa['description']}")
                    for accion in etapa["key_actions"]:
                        st.markdown(f"- {accion}")


if __name__ == "__main__":
    main()