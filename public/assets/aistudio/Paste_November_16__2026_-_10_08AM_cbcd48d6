            norma_sel = st.selectbox("Seleccione la Norma Vigente:", list(REPOSITORIO_NORMATIVO.keys()))
            info_norma = REPOSITORIO_NORMATIVO[norma_sel]
            st.write(f"**Nombre Oficial:** {info_norma['nombre']}")
            st.write("**Artículos y Disposiciones Clave:**")
            for art, desc in info_norma["articulos_clave"].items():
                st.markdown(f"- **{art}:** {desc}")

        st.markdown("---")
        
        # Gráfico Estadístico de Riesgos de los 16 Hallazgos
        df_res = pd.DataFrame(st.session_state.hallazgos_extraidos)
        if not df_res.empty and "Nivel de Riesgo" in df_res.columns:
            st.markdown("### 📈 Distribución Estadística de los 16 Hallazgos por Nivel de Riesgo")
            conteo_riesgos = df_res["Nivel de Riesgo"].value_counts()
            st.bar_chart(conteo_riesgos)

        st.markdown("---")
        correctos = [h for h in st.session_state.hallazgos_extraidos if "Correcto" in h.get("Estado", "")]
        ajustes = [h for h in st.session_state.hallazgos_extraidos if "Ajuste" in h.get("Estado", "") or "Observación" in h.get("Estado", "")]

        col_t1, col_t2 = st.tabs([f"🟢 Componentes Correctos ({len(correctos)})", f"🔴 Componentes con Observación / Ajuste ({len(ajustes)})"])

        with col_t1:
            for h in correctos:
                st.markdown(f"""
                    <div class="mejora-azul">
                        <strong>[{h.get('ID')}] {h.get('Sección / Acápite')}</strong><br>
                        <em>Calificación:</em> {h.get('Calificación (0-10)')}/10 | <span class="val-pass">{h.get('Estado')}</span><br>
                        <strong>Criterio Validado:</strong> {h.get('Criterio Sugerido IA')} ({h.get('Referencia Exacta')})
                    </div>
                """, unsafe_allow_html=True)

        with col_t2:
            for h in ajustes:
                st.markdown(f"""
                    <div class="alerta-roja">
                        <strong>[{h.get('ID')}] {h.get('Sección / Acápite')}</strong> — <em>Riesgo:</em> <b>{h.get('Nivel de Riesgo')}</b><br>
                        <em>Calificación:</em> {h.get('Calificación (0-10)')}/10 | <span class="val-fail">{h.get('Estado')}</span><br><br>
                        <strong>⚠️ Criterio Original:</strong> {h.get('Criterio Auditor')}<br>
                        <strong>✨ Criterio Sugerido por IA (10/10):</strong> <u>{h.get('Criterio Sugerido IA')}</u> [{h.get('Referencia Exacta')}]<br><br>
                        <strong>💡 Recomendación:</strong> {h.get('Recomendación de Mejora (10/10)')}
                    </div>
                """, unsafe_allow_html=True)

        st.markdown("---")
        st.markdown("## ✏️ Matriz Interactiva de los 16 Hallazgos Editable en Línea")
        df_editada = st.data_editor(df_res, num_rows="dynamic", use_container_width=True, key="editor_16_hallazgos")

        if st.button("💾 Guardar Cambios Realizados en Línea", type="primary"):
            st.session_state.hallazgos_extraidos = df_editada.to_dict(orient="records")
            st.success("¡Matriz de los 16 hallazgos actualizada con éxito!")

    # ==========================================================================
    # PASO 3: VERIFICACIÓN GUÍA CCRD Y DICTAMEN
    # ==========================================================================
    elif st.session_state.paso_actual == 3:
        st.markdown("## 📋 Paso 3: Verificación de Cumplimiento Guía CCRD & Ley núm. 18-24")
        st.info("Validación procesal de las etapas institucionales de control externo.")

        col_v1, col_v2, col_v3, col_v4 = st.columns(4)
        with col_v1: st.markdown("<div class='val-pass'>1. Planificación: CUMPLE</div>", unsafe_allow_html=True)
        with col_v2: st.markdown("<div class='val-pass'>2. Ejecución: CUMPLE</div>", unsafe_allow_html=True)
        with col_v3: st.markdown("<div class='val-pass'>3. Comunicación: CUMPLE</div>", unsafe_allow_html=True)
        with col_v4: st.markdown("<div class='val-pass'>4. Conclusión: APTO</div>", unsafe_allow_html=True)

        st.markdown("### Resumen del Blindaje Institucional (16 Hallazgos)")
        total = len(st.session_state.hallazgos_extraidos)
        promedio = sum([h.get('Calificación (0-10)', 0) for h in st.session_state.hallazgos_extraidos]) / total if total > 0 else 0
        
        col_m1, col_m2, col_m3 = st.columns(3)
        with col_m1: st.metric("Total Hallazgos Evaluados", total)
        with col_m2: st.metric("Promedio Puntaje (0-10)", f"{round(promedio, 1)} / 10")
        with col_m3: st.metric("Dictamen Final", "Apto para Autoridades")

