                st.success(f"¡Base de datos sincronizada! Se cargaron los {len(st.session_state.hallazgos_extraidos)} hallazgos completos.")
                st.info("Utilice el menú lateral para avanzar al **Paso 2: Matriz de los 16 Hallazgos**.")

